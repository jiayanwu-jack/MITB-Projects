# Core live backends
CRAWLER_BACKEND=crawl4ai
# LLM_BACKEND: ollama | openai | google | claude | deepseek
LLM_BACKEND=ollama

# Firecrawl, required only for CRAWLER_BACKEND=firecrawl
FIRECRAWL_API_KEY=

# Crawl4AI
CRAWL4AI_MAX_DEPTH=1
CRAWL4AI_PAGE_TIMEOUT_MS=60000
CRAWL4AI_HEADLESS=true

# OpenAI, required only for LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Google AI Studio / Gemini API, required only for LLM_BACKEND=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_MAX_INPUT_CHARS=60000

# Anthropic Claude API, required only for LLM_BACKEND=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_MAX_INPUT_CHARS=60000

# DeepSeek (OpenAI-compatible), required only for LLM_BACKEND=deepseek.
# Also the default backend for the in-app AI advisor when a key is set.
# Models: deepseek-v4-flash (cheaper/faster) or deepseek-v4-pro.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_INPUT_CHARS=20000

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_MAX_INPUT_CHARS=24000
OLLAMA_NUM_CTX=0

# Contact website crawl
CONTACT_MAX_PAGES=8

# Search enrichment: none | brave | tavily
SEARCH_BACKEND=brave
BRAVE_SEARCH_API_KEY=
# Tavily — an alternative to Brave, built for LLM/agent use (needs TAVILY_API_KEY).
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=8
SEARCH_MAX_PAGES_PER_CANDIDATE=6
SEARCH_QUERIES_PER_FOUNDER=4
ENABLE_FOUNDER_SEARCH=true
ENABLE_PDF_SEARCH=true

# Paid enrichment: none/hunter and none/apollo
EMAIL_PROVIDER=none
PEOPLE_PROVIDER=none
HUNTER_API_KEY=
APOLLO_API_KEY=
VERIFY_EMAILS=false
PAID_FALLBACK_ONLY=true
HUNTER_REQUEST_DELAY_SECONDS=0.25
HUNTER_RETRY_ATTEMPTS=3
HUNTER_RETRY_BACKOFF_SECONDS=2

# Apollo credit-sensitive options: disabled by default
APOLLO_REVEAL_PERSONAL_EMAILS=false
APOLLO_RUN_WATERFALL_EMAIL=false
APOLLO_POLL_ATTEMPTS=2
APOLLO_POLL_DELAY_SECONDS=2

# Competition
COMPETITION_NAME=SMU Student Startup Competition 2027
COMPETITION_YEAR=2027
ORGANIZER_NAME=Competition Organizing Team
ORGANIZER_SIGNATURE=Competition Organizing Team
COMPETITION_URL=

# Gmail OAuth
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
ALLOW_LIVE_SEND=false

# Outlook / Microsoft Graph OAuth, required only for automatic Outlook sending
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=common
OUTLOOK_TOKEN_PATH=outlook_token_cache.json
