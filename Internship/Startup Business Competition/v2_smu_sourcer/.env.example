# Copy this file to ".env" and fill in your keys. run.py loads .env automatically.
# .env is gitignored; real environment variables (setx / export) override these.

# --- LLM backend: "gemini" | "bedrock" | "ollama" | "auto" (default) ---
# "auto" uses Gemini if GEMINI_API_KEY is set, else Bedrock, else a local Ollama server.
SMU_LLM_PROVIDER=auto

# --- Local model via Ollama (fully offline, no key, no rate limits) ---
# Install https://ollama.com, then: ollama pull llama3 ; set SMU_LLM_PROVIDER=ollama above.
# OLLAMA_MODEL=llama3
# OLLAMA_HOST=http://localhost:11434

# --- Google AI Studio / Gemini (recommended - just an API key, free tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# --- AWS Bedrock (alternative for --llm; needs anthropic[bedrock] + IAM model access) ---
AWS_REGION=us-east-1
# Use the exact model / inference-profile id from your Bedrock console (often a us. prefix):
SMU_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
# Credentials: prefer `aws configure` / SSO. Only uncomment if using static keys:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# --- Tracxn paid database (optional, --source tracxn:<query>) ---
# TRACXN_API_KEY=your-token
# TRACXN_API_URL=https://platform.tracxn.com/api/2.2/companies

# --- Founder contact lookup (--find-contacts) ---
# LinkedIn URL search reuses SERPER_API_KEY / BRAVE_API_KEY below.
# Email finder (maps founder name + company domain -> email):
# HUNTER_API_KEY=...          # https://hunter.io  (free tier ~25 finds/month)

# --- Web search / news sources (optional) ---
# SERPER_API_KEY=...          # https://serper.dev  (Google results; also used for LinkedIn URL search)
# BRAVE_API_KEY=...           # https://brave.com/search/api/
